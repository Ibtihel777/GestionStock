{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API : compiler",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "ERPStock.sln"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "API : démarrer",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "ERPStock.API/ERPStock.API.csproj"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Frontend : démarrer",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/ERPStock.Frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GestionStock : démarrer",
      "dependsOn": ["API : démarrer", "Frontend : démarrer"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
